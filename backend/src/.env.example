PORT=4000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=citas_medicas
JWT_SECRET=
JWT_EXPIRES_IN=8h
CAPTCHA_TTL_MS=300000
APP_TIMEZONE=America/Mexico_City
UPLOADS_DIR=
TELEGRAM_BOT_TOKEN=
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ── Recordatorios automáticos (RN-100 / RN-101) ──────────────────────────────
# El scheduler del backend solo arranca si hay URL de n8n para notificar.
REMINDERS_ENABLED=true
REMINDERS_INTERVAL_MS=300000

# ── Útil solo para tests locales ─────────────────────────────────────────────
# Permite el captchaId='test' en registro/login. En producción debe ir vacío.
ALLOW_TEST_CAPTCHA=false
